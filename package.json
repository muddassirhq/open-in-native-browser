{
  "name": "open-in-native-browser",
  "version": "2.0.0",
  "description": "Make links tapped in Instagram, Facebook, LinkedIn, TikTok, Threads, X, Snapchat, WhatsApp and other in-app browsers open in the visitor's real browser (and from there, the right app). Auto handoff + fallback banner. Zero dependencies, any framework.",
  "main": "src/index.js",
  "module": "src/index.mjs",
  "unpkg": "dist/auto.global.js",
  "jsdelivr": "dist/auto.global.js",
  "browser": "dist/auto.global.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./src/index.mjs",
      "require": "./src/index.js",
      "default": "./src/index.js"
    },
    "./auto": "./dist/auto.global.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist",
    "index.d.ts",
    "skills",
    "llms.txt",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/auto.global.js"
  ],
  "keywords": [
    "android",
    "breakout",
    "deep-link",
    "disallowed_useragent",
    "escape",
    "external-browser",
    "facebook",
    "in-app-browser",
    "in-app-browser-escape",
    "instagram",
    "ios",
    "line",
    "link-in-bio",
    "link-shortener",
    "linkedin",
    "meta",
    "open-in-browser",
    "snapchat",
    "telegram",
    "threads",
    "tiktok",
    "twitter",
    "webview",
    "wechat",
    "whatsapp",
    "x-safari"
  ],
  "author": "muddassirhq",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muddassirhq/open-in-native-browser.git"
  },
  "homepage": "https://muddassirhq.github.io/open-in-native-browser",
  "bugs": {
    "url": "https://github.com/muddassirhq/open-in-native-browser/issues"
  },
  "engines": {
    "node": ">=12"
  },
  "types": "index.d.ts",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test test/detect.test.mjs",
    "prepublishOnly": "npm test"
  }
}
